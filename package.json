{
  "name": "vc-premium-platform",
  "private": true,
  "version": "0.1.0",
  "description": "VC Premium Experience — static intelligence platform for venture capital.",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "predev": "npm run build:memo && npm run split:content",
    "dev": "npm run dev --workspace client",
    "split:content": "npm run split:glossary && npm run split:lessons",
    "split:glossary": "node scripts/split-glossary.mjs",
    "split:lessons": "node scripts/split-lessons.mjs",
    "prebuild": "npm run build:memo && npm run split:content && npm run validate:content && npm run generate:sitemap",
    "build": "npm run build --workspace client",
    "postbuild": "npm run prerender:strict",
    "prerender": "npm run prerender:strict",
    "prerender:strict": "node scripts/prerender.mjs --strict",
    "prerender:tolerant": "node scripts/prerender.mjs --tolerant",
    "lint": "npm run lint:client && npm run lint:node",
    "lint:client": "npm run lint --workspace client",
    "lint:node": "eslint --config client/eslint.node.config.js scripts shared .claude/hooks --max-warnings=0",
    "typecheck": "npm run typecheck --workspace client",
    "test": "npm run test --workspace client && npm run test:node",
    "test:node": "node --test --test-concurrency=1 scripts/*.test.mjs shared/*.test.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "build:memo": "node scripts/build-investment-memo.mjs",
    "check:memo": "node scripts/build-investment-memo.mjs --check",
    "check": "npm run check:generated && npm run validate:content:strict && npm run validate:glossary && npm run typecheck && npm run lint && npm run test",
    "validate:content": "node scripts/validate-content.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "validate:glossary": "node scripts/validate-glossary.mjs",
    "validate:content:strict": "node scripts/validate-content.mjs --strict",
    "validate:formation": "node scripts/formation-readiness.mjs",
    "aliases:merge": "node scripts/merge-aliases.mjs"
  },
  "devDependencies": {
    "puppeteer": "^25.2.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
