{
  "name": "vc-premium-platform",
  "private": true,
  "version": "0.1.0",
  "description": "VC Premium Experience — static intelligence platform for venture capital.",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "predev": "npm run split:content",
    "dev": "npm run dev --workspace client",
    "dev:client": "npm run dev --workspace client",
    "split:content": "npm run split:glossary && npm run split:lessons",
    "split:glossary": "node scripts/split-glossary.mjs",
    "split:lessons": "node scripts/split-lessons.mjs",
    "prebuild": "npm run split:content && npm run validate:content && npm run generate:sitemap",
    "build": "npm run build --workspace client",
    "postbuild": "npm run prerender",
    "prerender": "node scripts/prerender.mjs",
    "lint": "npm run lint --workspace client",
    "validate:content": "node scripts/validate-content.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "validate:glossary": "node scripts/validate-glossary.mjs",
    "validate:content:strict": "node scripts/validate-content.mjs --strict",
    "aliases:merge": "node scripts/merge-aliases.mjs"
  },
  "devDependencies": {
    "puppeteer": "^25.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
