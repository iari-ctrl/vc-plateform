#!/bin/bash
# VC Premium Experience — garantit le serveur de dev puis ouvre la fenêtre PWA Chrome.
PROJECT_DIR="/Users/iar-witness/Documents/Projets/VC SITE/vc-platform"
LOG="/tmp/vc-premium-dev.log"
HERE="$(cd "$(dirname "$0")" && pwd)"

# Une app lancée au double-clic n'hérite pas du PATH du terminal ; node/npm = ~/.local/bin.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

# Démarre le serveur uniquement si Vite n'écoute pas déjà sur :5173.
if ! nc -z localhost 5173 >/dev/null 2>&1; then
  cd "$PROJECT_DIR" || exit 1
  nohup npm run dev >"$LOG" 2>&1 &
  # Attente jusqu'à ~60 s que Vite réponde.
  for _ in $(seq 1 120); do
    nc -z localhost 5173 >/dev/null 2>&1 && break
    sleep 0.5
  done
fi

# Passe la main au vrai loader Chrome (fenêtre PWA d'origine, Info.plist inchangé pour l'URL).
exec "$HERE/app_mode_loader" "$@"
